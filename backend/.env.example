# ==============================================================
# .env.example — Variables de entorno para el backend
# Copiar a .env y ajustar valores
# ==============================================================

# ── Modelos YOLO ──────────────────────────────────────────────
MODEL_MICRO_PATH=models/micro_detector_v1.pt
MODEL_PLATE_PATH=models/plate_detector_v1.pt

# ── GPU ───────────────────────────────────────────────────────
USE_GPU=true
DEVICE=0

# ── Confianzas mínimas ─────────────────────────────────────────
MIN_MICRO_CONFIDENCE=0.40
MIN_PLATE_CONFIDENCE=0.35
MIN_OCR_CONFIDENCE=0.50

# ── Deduplicación ─────────────────────────────────────────────
DEDUP_WINDOW_MINUTES=5

# ── Base de datos ─────────────────────────────────────────────
DB_PATH=backend/db/placas_micros.db

# ── Almacenamiento de evidencias ──────────────────────────────
STORAGE_PATH=backend/storage

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── OCR ───────────────────────────────────────────────────────
OCR_ENGINE=paddleocr
PADDLEOCR_LANG=en
OCR_LANGUAGES=es
OCR_PREPROCESS_VARIANT=default
EASYOCR_MODEL_DIR=models/easyocr

# ── Tracking ──────────────────────────────────────────────────
TRACKER_CONFIG=configs/bytetrack_micros.yaml

# ── Video ─────────────────────────────────────────────────────
VIDEO_SAMPLE_FPS=5
OCR_CANDIDATES_PER_TRACK=3

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
